# Salin file ini ke .env.local (file .env.local diabaikan oleh git).
# Jangan pernah menaruh service_role key di sini atau di repo.

# URL proyek Supabase (untuk CMS admin)
VITE_SUPABASE_URL=

# Anon key publik Supabase (aman di klien karena RLS aktif)
VITE_SUPABASE_ANON_KEY=

# Base URL bucket publik Supabase Storage (untuk app anak membaca manifest & media)
VITE_CONTENT_BASE_URL=

# Domain email sintetis untuk pemetaan username -> email login admin
VITE_ADMIN_EMAIL_DOMAIN=
VITE_FEATURE_ONLINE_ROOM=0
